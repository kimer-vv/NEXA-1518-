  "functions": [
    {
      "proname": "transfer_staff_account_from_token",
      "definition": "CREATE OR REPLACE FUNCTION public.transfer_staff_account_from_token(p_token text)\n RETURNS uuid\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'extensions'\nAS $function$\n  select coalesce(ctx.id,s.account_id)\n  from public.transfer_staff_sessions s\n  left join public.player_accounts pa on pa.id=s.active_player_account_id\n  left join lateral (\n    select a.id\n    from public.transfer_staff_accounts a\n    where a.game_id=pa.player_id\n    order by a.created_at\n    limit 1\n  ) ctx on true\n  where s.token_hash=encode(digest(coalesce(p_token,''),'sha256'),'hex')\n    and s.expires_at>now()\n  order by s.created_at desc\n  limit 1\n$function$\n"
    },
    {
      "proname": "nexa_workspace_access_actor_v1",
      "definition": "CREATE OR REPLACE FUNCTION public.nexa_workspace_access_actor_v1(p_token text)\n RETURNS TABLE(account_id uuid, game_id text, is_global_owner boolean)\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'extensions'\nAS $function$\ndeclare\n  v_hash text;\n  v_account uuid;\n  v_game text;\n  v_user uuid;\n  v_dev_user uuid;\n  v_dev_owner boolean:=false;\nbegin\n  v_hash:=encode(digest(coalesce(p_token,''),'sha256'),'hex');\n  select s.account_id,s.developer_user_id into v_account,v_dev_user\n  from public.transfer_staff_sessions s\n  where s.token_hash=v_hash and s.expires_at>now()\n  limit 1;\n  if v_account is null then return; end if;\n\n  select a.game_id into v_game from public.transfer_staff_accounts a where a.id=v_account;\n\n  if v_dev_user is not null then\n    select exists(select 1 from public.user_roles r where r.user_id=v_dev_user and lower(r.role)='owner')\n      or exists(select 1 from public.nexa_platform_roles p where p.user_id=v_dev_user and (p.is_platform_owner or p.developer_mode_allowed)) into v_dev_owner;\n    if not v_dev_owner then return; end if;\n    account_id:=v_account;\n    game_id:=coalesce(v_game,'0000');\n    is_global_owner:=true;\n    return next;\n    return;\n  end if;\n\n  select p.user_id into v_user from public.player_accounts p where p.player_id=v_game order by p.is_main desc nulls last limit 1;\n  account_id:=v_account;\n  game_id:=v_game;\n  is_global_owner:=exists(select 1 from public.user_roles r where r.user_id=v_user and lower(r.role)='owner');\n  return next;\nend\n$function$\n"
    }
  ]
}